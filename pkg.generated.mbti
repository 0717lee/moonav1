pub fn IccProfile::apply_rgba8(Self, Image) -> Result[Image, DecodeError]
pub fn IccProfile::apply_rgba8_with_options(Self, Image, IccTransformOptions) -> Result[Image, DecodeError]
pub fn IccProfile::parse(Array[Byte]) -> Result[Self, DecodeError]

pub(all) enum IccRenderingIntent {
  Perceptual
  RelativeColorimetric
  Saturation
  AbsoluteColorimetric
}

pub struct IccTransformOptions {
  intent : IccRenderingIntent
  black_point_compensation : Bool
}
pub fn IccTransformOptions::new(IccRenderingIntent, Bool) -> Self
pub fn IccTransformOptions::relative_colorimetric() -> Self

pub(all) struct Image {
  width : Int32
  height : Int32
  data : FixedArray[Byte]
}
pub fn Image::copy(Self) -> Self
pub fn Image::from_bytes(Int32, Int32, FixedArray[Byte]) -> Self
pub fn Image::get_pixel(Self, Int32, Int32) -> (Byte, Byte, Byte, Byte)
pub fn Image::new(Int32, Int32) -> Self
pub fn Image::pixel_count(Self) -> Int32
pub fn Image::set_pixel(Self, Int32, Int32, Byte, Byte, Byte, Byte) -> Unit

pub struct Image16 {
  width : Int32
  height : Int32
  data : FixedArray[UInt16]
}
pub fn Image16::copy_bytes_into(Self, FixedArray[Byte], Int32, big_endian? : Bool, offset? : Int32) -> Result[Unit, DecodeError]

pub(all) enum PixelPacking {
  U8
  U16LE
  U16BE
  High16LE
  High16BE
} derive(Eq, @debug.Debug)

