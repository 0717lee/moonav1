    "007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079",
    "007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c",
    "007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b",
    "007a007a007b007c007d007d007b0079007a007f7b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a00",
    "7b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b00",
    "79007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b00",
    "7c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d00",
    "7b007a007a007b007c007d007d007b0079007a007b007a007b007b007c007d007b007a007a007b007c007d007d007b0079007a00007b00",
  ])
  let decoder = av1_video_decoder()
  let first = av1_video_decode_temporal_unit_native(decoder, key).unwrap()[0]
  let next = native_test_frame(first, expected, 0, 64, 64, 8, true, true)
  for plane in first.planes {
    for i in 0..<plane.data.length() {
      plane.data[i] = 0
    }
  }
  assert_eq(
    av1_video_decode_temporal_unit_native(decoder, hidden).unwrap().length(),
    0,
  )
  let shown = av1_video_decode_temporal_unit_native(decoder, show).unwrap()[0]
  let end = native_test_frame(shown, expected, next, 64, 64, 8, true, true)
  for plane in shown.planes {
    for i in 0..<plane.data.length() {
      plane.data[i] = 0
    }
  }
  let again = av1_video_decode_temporal_unit_native(decoder, show).unwrap()[0]
  assert_eq(
    native_test_frame(again, expected, next, 64, 64, 8, true, true),
    end,
  )
  let rgb = av1_video_decode_temporal_unit(decoder, inter).unwrap()[0]
  let fresh = av1_video_decoder()
  av1_video_decode_temporal_unit(fresh, key) |> ignore
  let expected_rgb = av1_video_decode_temporal_unit(fresh, inter).unwrap()[0]
  for i in 0..<rgb.data.length() {
    assert_eq(rgb.data[i], expected_rgb.data[i])
  }
  assert_eq(
    native_test_frame(again, expected, next, 64, 64, 8, true, true),
    end,
  )
}

///|
test "native API rejects malformed input and distinguishes no presentation" {
  assert_true(av1_decode_native([]) is None)
  assert_true(avif_decode_native([]) is None)
  assert_true(av1_decode_native([0x0a, 0x01, 0x18]) is None)
  assert_true(
    av1_video_decode_temporal_unit_native(av1_video_decoder(), [
      0x1a, 0x01, 0x98,
    ])
    is None,
  )
  let sequence = native_test_bytes(["12000a0900000002afffb83601"])
  assert_true(av1_decode_native(sequence) is None)
  assert_eq(
    av1_video_decode_temporal_unit_native(av1_video_decoder(), sequence)
    .unwrap()
    .length(),
    0,
  )
}
