    "081c0926092109b90872086808670817086508e3076e07be079b0752088508f70841094c0939092509ed08ab084a08ec078b074b07270735",
    "075f07a207da07fe076a08e4083e096e0972095b091e09d208850841081308f807f107f407fc070308000801080208030804080508060807",
    "08080809080a080b080c080d080e080f0810081108120813081408150816081708180819081a081b081c081d081e081f084d092f09f708ac",
    "085508fb07a5075c072b07200737076d07b107f8073208530830092b090c096a08560877085a0819087408de074c077307590703083a08fd",
    "083fd808e308d308c50890084d08f5079c0743070e07f4060b073d078707c507ed078d08fc0845095f095a093509f208a40856080d08d807",
    "b407a3079e079f07a30740084108420843084408450846084708480849084a084b084c084d084e084f085008510852085308540855085608",
    "5708580859085a085b085c085d085e085f08",
  ])
  let alpha = image.alpha.unwrap()
  assert_eq(
    native_test_frame(
      alpha,
      alpha_expected,
      0,
      96,
      98,
      12,
      false,
      false,
      mono=true,
    ),
    alpha_expected.length(),
  )
  let original = image.color.planes[0].data[0]
  alpha.planes[0].data[0] = -1
  assert_eq(image.color.planes[0].data[0], original)
  // A corrupt auxiliary payload must reject the whole native/RGBA image.
  let descriptor = avif_alpha_item_descriptor(input).unwrap()
  input[descriptor.extents[0].offset] = 0xff
  assert_true(avif_decode_native(input) is None)
  assert_true(avif_decode_rgba(input) is None)
}

