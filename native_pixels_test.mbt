///|
// Existing hidden_inter_show_existing fixture, split at its OBU boundaries.
test "native API ownership hidden updates show-existing and mixed outputs" {
  let key = native_test_bytes([
    "12000a0900000002afffb83601326a1040009308dfae5924baa8094b8215311279c7de8a550aa84532423d3c17b6a6f45655f45f69170af8",
    "9a25a845133fffffff7ddc03e36bce2710586e3aaf92a5bdcb6be262af4ba1734b5e63bffff633d6feb4297c8540471cad78bd5320392b2e",
    "1b2bef405436784f80",
