  let sought = decoder.seek_frame(2).unwrap()
  assert_eq(sought.index, 2)
  stream_same_frame(sought.image.color, image.color)
  stream_same_frame(sought.image.alpha.unwrap(), image.alpha.unwrap())
  let saved = decoder.metadata().icc.unwrap()[0]
  metadata.icc.unwrap()[0] = (saved.to_int() ^ 255).to_byte()
  assert_eq(decoder.metadata().icc.unwrap()[0], saved)
