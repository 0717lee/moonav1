      "f4006501d6014702b802",
    ]),
  ]
  for i in 0..<3 {
    let image = animation.frames[i].image
    assert_eq(
      native_test_frame(image.color, colors[i], 0, 16, 16, 12, false, false),
      colors[i].length(),
    )
    assert_eq(image.color.matrix_coefficients, 6)
    assert_true(image.color.full_range)
    assert_eq(image.premultiplied, true)
    let alpha = image.alpha.unwrap()
    assert_eq(
      native_test_frame(
        alpha,
        alphas[i],
        0,
        16,
        16,
        12,
        false,
        false,
        mono=true,
      ),
      alphas[i].length(),
    )
    assert_true(alpha.full_range)
  }
  native_animation_ownership(animation)
}

