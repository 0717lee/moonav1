      "5703c8033900aa001b018c01fd016e02df0205017601e7015802c9023a03ab031c008d00fe006f01e0015102c2023303a403ca013b02ac02",
      "1d038e03ff037000e1005201c3013402a50216038703f80369008f0200037103e2035300c4003501a60117028802f9026a03db034c00bd00",
      "2e015403c5033600a70018018901fa016b02dc024d03be032f00a00011018201f30119008a00fb006c01dd014e02bf023003a10312008300",
      "f4006501d6014702b802",
    ]),
  ]
  for i in 0..<3 {
    let image = animation.frames[i].image
    assert_eq(
      native_test_frame(image.color, colors[i], 0, 16, 16, 10, false, false),
      colors[i].length(),
    )
    assert_eq(image.color.matrix_coefficients, 0)
    assert_true(image.color.full_range)
    assert_eq(image.premultiplied, true)
    let alpha = image.alpha.unwrap()
    assert_eq(
      native_test_frame(
        alpha,
        alphas[i],
        0,
        16,
        16,
        10,
        false,
        false,
        mono=true,
      ),
      alphas[i].length(),
    )
    assert_true(alpha.full_range)
  }
  native_animation_ownership(animation)
}

