      "7f0000ff0f0100010801045d04b60412056e05c70523067f06d80634079007e90719037503d1032a048604e2043b059705f3054c06a80604",
      "075d07b90715086e089e03fa035604af040b056705c0051c067806d1062d078907e2073e089a08f30823047f04db0434059005ec054506a1",
      "06fd065607b2070e086708c3081f097809a80404056005b90515067106ca0626078207db0737089308ec084809a409fd092d058905e5053e",
      "069a06f6064f07ab0707086008bc0818097109cd09290a820ab2050e066a06c3061f077b07d40730088c08e50841099d09f609520aae0a07",
      "0b37069306ef064807a40700085908b50811096a09c609220a7b0ad70a330b8c0b7fbc0618077407cd0729088508de083a099609ef094b0a",
      "a70a000b5c0bb80b110c41079d07f9075208ae080a096309bf091b0a740ad00a2c0b850be10b3d0c960cc60722087e08d70833098f09e809",
      "440aa00af90a550bb10b0a0c660cc20c1b0d4b08a70803095c09b809140a6d0ac90a250b7e0bda0b360c8f0ceb0c470da00dd0082c098809",
      "e1093d0a990af20a4e0baa0b030c5f0cbb0c140d700dcc0d250e5509b1090d0a660ac20a1e0b770bd30b2f0c880ce40c400d990df50d510e",
      "aa0eda09360a920aeb0a470ba30bfc0b580cb40c0d0d690dc50d1e0e7a0ed60e2f0f5f0abb0a170b700bcc0b280c810cdd0c390d920dee0d",
      "4a0ea30eff0e5b0fb40f",
    ]),
  ]
  for i in 0..<3 {
    let image = animation.frames[i].image
    let color = image.color
    assert_eq((color.width, color.height, color.bit_depth), (16, 16, 12))
    assert_eq(color.planes.length(), 3)
    assert_false(image.premultiplied)
    let alpha = image.alpha.unwrap()
    assert_eq(
      native_test_frame(
        alpha,
        expected[i],
        0,
        16,
        16,
        12,
        false,
        false,
        mono=true,
      ),
      expected[i].length(),
    )
    assert_true(alpha.full_range)
    assert_eq(
      (
        color.color_primaries,
        color.transfer_characteristics,
        color.matrix_coefficients,
      ),
      (1, 13, 1),
    )
  }
  native_animation_ownership(animation)
}

