/// Generated by scripts/generate-color-display-reference.py.
/// ICC outputs come from LittleCMS; HDR and geometry use Decimal/Fraction.

///|
fn icc_reference_check(
  profile_bytes : Array[Byte],
  source : Array[Int],
  expected : Array[Int],
  tolerance : Int,
) -> Unit raise {
  let profile = IccProfile::parse(profile_bytes).unwrap()
  let image : Image16 = {
    width: source.length() / 4,
    height: 1,
    data: FixedArray::makei(source.length(), i => source[i].to_uint16()),
  }
  let actual = profile.apply_rgba16(image).unwrap()
  assert_eq(actual.data.length(), expected.length())
  for i in 0..<expected.length() {
    let difference = actual.data[i].to_int() - expected[i]
    if i % 4 == 3 {
      assert_eq(difference, 0)
    } else {
      assert_true(
        difference >= -tolerance && difference <= tolerance,
        msg="ICC channel differs at \{i}: \{actual.data[i]} versus \{expected[i]}",
      )
    }
  }
}

///|
test "Decimal HDR native output 0" {
  let frame : Av1NativeFrame = {
    width: 1,
    height: 1,
    bit_depth: 10,
    subsampling_x: false,
    subsampling_y: false,
    full_range: true,
    matrix_coefficients: 0,
    color_primaries: 9,
    transfer_characteristics: 16,
    planes: [
      { width: 1, height: 1, data: [0], },
      { width: 1, height: 1, data: [0], },
      { width: 1, height: 1, data: [0], },
    ],
  }
  let output = frame.to_sdr_rgba16().unwrap()
  let expected = [0, 0, 0, 65535]
  for channel in 0..<4 {
    let difference = output.data[channel].to_int() - expected[channel]
    if channel == 3 {
      assert_eq(difference, 0)
    } else {
      assert_true(
        difference >= -1 && difference <= 1,
        msg="HDR channel \{channel}: \{output.data[channel]} versus \{expected[channel]}",
      )
    }
  }
}

