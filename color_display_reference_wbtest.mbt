///|
test "Fraction public resampling line 2" {
  let source : Image16 = {
    width: 3,
    height: 1,
    data: [65535, 0, 0, 65535, 0, 65535, 0, 32768, 0, 0, 65535, 0],
  }
  let metadata : AvifMetadata = {
    primary_item_id: None,
    track_id: None,
    icc: None,
    exif: None,
    exif_tiff_offset: None,
    xmp: None,
    pixel_aspect_ratio: None,
    transforms: [
      Crop({
        width_n: 1L,
        width_d: 1L,
        height_n: 1L,
        height_d: 1L,
        horizontal_n: -1L,
        horizontal_d: 2L,
        vertical_n: 0L,
        vertical_d: 1L,
      }),
    ],
  }
  let output = metadata.resample_rgba16(source, 1, 1).unwrap()
  let expected : FixedArray[UInt16] = [43690, 21845, 0, 49152]
  assert_eq(output.data, expected)
}

