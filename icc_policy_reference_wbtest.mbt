///|
/// Generated by scripts/generate-icc-policy-reference.py.
/// Outputs are independent LittleCMS 2.19 public-ABI references.
fn icc_policy_assert(
  profile_bytes : Array[Byte],
  source : Array[Int],
  expected : Array[Int],
  options : IccTransformOptions,
) -> Unit raise {
  let profile = IccProfile::parse(profile_bytes).unwrap()
  let source_image : Image16 = {
    width: source.length() / 4,
    height: 1,
    data: FixedArray::makei(source.length(), i => source[i].to_uint16()),
  }
  let actual = profile.apply_rgba16_with_options(source_image, options).unwrap()
  assert_eq(actual.data.length(), expected.length())
  for i in 0..<expected.length() {
    let difference = actual.data[i].to_int() - expected[i]
    if i % 4 == 3 {
      assert_eq(difference, 0)
    } else {
      assert_true(
        difference >= -8 && difference <= 8,
        msg="ICC policy channel differs at \{i}: \{actual.data[i]} versus \{expected[i]}",
      )
    }
  }
}

