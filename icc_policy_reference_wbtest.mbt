    source_relative,
    expected_relative,
    IccTransformOptions::new(RelativeColorimetric, false),
  )
  let source_saturation = [
    0, 8192, 16384, 65535, 32768, 49152, 24576, 61166, 65535, 65535, 0, 32768, 12345,
    54321, 22222, 77,
  ]
  let expected_saturation = [
    0, 8344, 13439, 65535, 65535, 3350, 7740, 61166, 65535, 0, 32648, 32768, 53232,
    0, 5107, 77,
  ]
  icc_policy_assert(
    profile,
    source_saturation,
    expected_saturation,
    IccTransformOptions::new(Saturation, false),
  )
  let source_absolute = [
    0, 8192, 16384, 65535, 32768, 49152, 24576, 61166, 65535, 65535, 0, 32768, 12345,
    54321, 22222, 77,
  ]
  let expected_absolute = [
    0, 11829, 12992, 65535, 65535, 15996, 5422, 61166, 65535, 16579, 30682, 32768,
    52331, 0, 3472, 77,
  ]
  icc_policy_assert(
    profile,
    source_absolute,
    expected_absolute,
    IccTransformOptions::new(AbsoluteColorimetric, false),
  )
  let expected_bpc = [
    18699, 0, 0, 65535, 65535, 12399, 0, 61166, 65535, 16543, 20833, 32768, 55340,
    0, 0, 77,
  ]
  icc_policy_assert(
    profile,
    source_relative,
    expected_bpc,
    IccTransformOptions::new(RelativeColorimetric, true),
  )
}

