///|
fn container_seek_le(
  data : Array[Byte],
  at : Int,
  width : Int,
  value : Int64,
) -> Unit {
  for i in 0..<width {
    data[at + i] = ((value >> (8 * i)) & 255L).to_int().to_byte()
  }
}

///|
/// Build a small IVF around retained AV1 samples. The samples are full OBU
/// temporal units, so each packet can be decoded by the real video decoder.
fn container_seek_ivf(
  samples : Array[Array[Byte]],
  timestamps : Array[Int64],
) -> Array[Byte] {
  let data = Array::make(32, b'\x00')
  data[0] = b'D'
  data[1] = b'K'
  data[2] = b'I'
  data[3] = b'F'
  container_seek_le(data, 6, 2, 32L)
  data[8] = b'A'
  data[9] = b'V'
  data[10] = b'0'
  data[11] = b'1'
  container_seek_le(data, 12, 2, 64L)
  container_seek_le(data, 14, 2, 64L)
  container_seek_le(data, 16, 4, 1000L)
  container_seek_le(data, 20, 4, 1L)
  container_seek_le(data, 24, 4, samples.length().to_int64())
  for i in 0..<samples.length() {
    let sample = samples[i]
    let at = data.length()
    for _ in 0..<12 {
      data.push(0)
    }
    container_seek_le(data, at, 4, sample.length().to_int64())
    container_seek_le(data, at + 4, 8, timestamps[i])
    for byte in sample {
      data.push(byte)
    }
  }
  data
}

///|
fn container_seek_track(
  timescale : Int64,
  movie_timescale : Int64?,
  edits : Array[Av1TrackEdit],
) -> Av1DemuxedTrack {
  {
    format: Ivf,
    track_id: 0L,
    width: 64,
    height: 64,
    timescale,
    movie_timescale,
    edits,
    codec_initialization: [],
    packets: [],
  }
}

///|
fn container_seek_decoder_from_samples(
  samples : Array[Array[Byte]],
  timestamps : Array[Int64?],
  limits? : DecodeLimits = DecodeLimits::default(),
) -> Av1ContainerDecoder {
  let packets : Array[Av1Packet] = Array::makei(samples.length(), i => {
    data: samples[i].copy(),
    presentation_timestamp: timestamps[i],
    decode_timestamp: None,
    duration: None,
    sync_sample: None,
  })
  {
    track: {
      format: Ivf,
      track_id: 0L,
      width: 64,
      height: 64,
      timescale: 1L,
      movie_timescale: None,
      edits: [],
      codec_initialization: [],
      packets,
    },
    limits,
    decoder: av1_video_decoder(),
    next_index: 0,
    failure: None,
    verified_random_access: Array::make(samples.length(), false),
  }
}

///|
test "container seek keeps owned AV1 packets and preserves position/reset" {
  let raw = container_seek_key_sample()
  let input = container_seek_ivf([raw, raw, raw], [0L, 1L, 2L])
  let expected = av1_decode_native(raw).unwrap()
  let decoder = Av1ContainerDecoder::new(input).unwrap()
  for i in 0..<input.length() {
    input[i] = 0
  }
  let first = decoder.next_frame().unwrap().unwrap()
  assert_eq(first.packet_index, 0)
  assert_eq(first.timestamp, Some(0L))
  assert_eq(first.frame.planes[0].data, expected.planes[0].data)
  first.frame.planes[0].data[0] = -1
  let second = decoder.next_frame().unwrap().unwrap()
  assert_eq(second.packet_index, 1)
  assert_eq(second.timestamp, Some(1L))
  assert_eq(second.frame.planes[0].data[0], expected.planes[0].data[0])
  assert_eq(decoder.position(), 2)
  decoder.reset()
  assert_eq(decoder.position(), 0)
  assert_eq(decoder.next_frame().unwrap().unwrap().packet_index, 0)
}

///|
test "container seek reports at-or-after semantics, EOF and backward reset" {
  let raw = container_seek_key_sample()
  let decoder = Av1ContainerDecoder::new(
    container_seek_ivf([raw, raw, raw], [0L, 10L, 20L]),
  ).unwrap()
  let exact = decoder.seek_timestamp(10L).unwrap()
  assert_eq(exact.outcome, Exact)
  assert_eq(exact.frame.unwrap().timestamp, Some(10L))
  assert_eq(decoder.position(), 2)
  let next = decoder.seek_timestamp(11L).unwrap()
  assert_eq(next.outcome, Next)
  assert_eq(next.frame.unwrap().timestamp, Some(20L))
  assert_eq(decoder.position(), 3)
  let end = decoder.seek_timestamp(21L).unwrap()
  assert_eq(end.outcome, End)
  assert_true(end.frame is None)
  assert_eq(decoder.position(), 3)
  let back = decoder.seek_timestamp(-1L).unwrap()
  assert_eq(back.outcome, Next)
  assert_eq(back.frame.unwrap().timestamp, Some(0L))
  assert_eq(decoder.position(), 1)
}

///|
test "container seek preserves decode order for nonmonotone and unknown PTS" {
  let raw = container_seek_key_sample()
  let nonmonotone = container_seek_decoder_from_samples([raw, raw, raw], [
    Some(10L),
    Some(0L),
    Some(20L),
  ])
  let first = nonmonotone.seek_timestamp(1L).unwrap()
  assert_eq(first.outcome, Next)
  assert_eq(first.frame.unwrap().timestamp, Some(10L))
  let unknown = container_seek_decoder_from_samples([raw, raw], [None, Some(1L)])
  let result = unknown.seek_timestamp(0L).unwrap()
  assert_eq(result.outcome, UnknownTimestamp)
  assert_eq(result.frame.unwrap().timestamp, None)
}

///|
test "container sync marks are accepted only after independent AV1 decoding" {
  let raw = container_seek_key_sample()
  let decoder = container_seek_decoder_from_samples([[0x0A], raw], [
    Some(0L),
    Some(1L),
  ])
  decoder.track.packets[1] = {
    ..decoder.track.packets[1],
    sync_sample: Some(true),
  }
  let result = decoder.seek_timestamp(1L).unwrap()
  assert_eq(result.outcome, Exact)
  assert_eq(result.frame.unwrap().timestamp, Some(1L))
}

///|
test "container seek shares one work budget across candidate and preroll" {
  let raw = container_seek_key_sample()
  let decoder = container_seek_decoder_from_samples(
    [raw, raw],
    [Some(0L), Some(1L)],
    limits={ ..DecodeLimits::default(), max_frames: 1, },
  )
  match decoder.seek_timestamp(1L) {
    Err(error) => assert_eq(error.kind, LimitExceeded)
    Ok(_) => fail("Seek reset the budget between packets")
  }
  match decoder.seek_timestamp(1L) {
    Err(error) => assert_eq(error.kind, LimitExceeded)
    Ok(_) => fail("Seek failure was not sticky")
  }
  decoder.reset()
  assert_eq(decoder.position(), 0)
}

///|
test "explicit MP4 timeline retains empty, media, repeated and end segments" {
  let timeline = Av1PresentationTimeline::new(
    container_seek_track(1000L, Some(100L), [
      { duration: 10L, media_time: -1L, media_rate: 65536, },
      { duration: 20L, media_time: 30L, media_rate: 65536, },
      { duration: 10L, media_time: 30L, media_rate: 65536, },
    ]),
  ).unwrap()
  assert_true(timeline.has_edits())
  assert_eq(timeline.edit_count(), 3)
  assert_eq(timeline.map_movie_time(0L).unwrap(), Empty)
  assert_eq(timeline.map_movie_time(9L).unwrap(), Empty)
  assert_eq(
    timeline.map_movie_time(10L).unwrap(),
    Media({ numerator: 3000L, denominator: 100L, }),
  )
  assert_eq(
    timeline.map_movie_time(11L).unwrap(),
    Media({ numerator: 4000L, denominator: 100L, }),
  )
  assert_eq(
    timeline.map_movie_time(30L).unwrap(),
    Media({ numerator: 3000L, denominator: 100L, }),
  )
  assert_eq(timeline.map_movie_time(40L).unwrap(), End)
}

///|
test "raw timeline does not synthesize edits and arithmetic is checked" {
  let raw = Av1PresentationTimeline::new(
    container_seek_track(1000L, Some(100L), []),
  ).unwrap()
  assert_false(raw.has_edits())
  assert_eq(
    raw.map_movie_time(55L).unwrap(),
    Media({ numerator: 55L, denominator: 1L, }),
  )
  let overflowing = Av1PresentationTimeline::new(
    container_seek_track(1L, Some(9223372036854775807L), [
      { duration: 1L, media_time: 2L, media_rate: 65536, },
    ]),
  ).unwrap()
  let overflow = overflowing.map_movie_time(0L)
  match overflow {
    Err(error) => assert_eq(error.kind, LimitExceeded)
    Ok(_) => fail("Timeline overflow was silently accepted")
  }
}

///|
test "presentation timeline validates rates scales and cumulative endpoints" {
  assert_eq(
    demux_test_error(
      Av1PresentationTimeline::new(container_seek_track(0L, None, [])),
    ),
    InvalidData,
  )
  let edit : Av1TrackEdit = { duration: 1L, media_time: 0L, media_rate: 65536, }
  assert_eq(
    demux_test_error(
      Av1PresentationTimeline::new(container_seek_track(1L, None, [edit])),
    ),
    InvalidData,
  )
  assert_eq(
    demux_test_error(
      Av1PresentationTimeline::new(container_seek_track(1L, Some(0L), [edit])),
    ),
    InvalidData,
  )
  assert_eq(
    demux_test_error(
      Av1PresentationTimeline::new(
        container_seek_track(1L, Some(1L), [{ ..edit, media_rate: 0, }]),
      ),
    ),
    Unsupported,
  )
  let timeline = Av1PresentationTimeline::new(
    container_seek_track(1L, Some(1L), [
      { ..edit, duration: 9223372036854775807L, media_time: -1L, },
      edit,
    ]),
  ).unwrap()
  assert_eq(demux_test_error(timeline.map_movie_time(-1L)), InvalidData)
  assert_eq(timeline.map_movie_time(9223372036854775806L).unwrap(), Empty)
  assert_eq(
    demux_test_error(timeline.map_movie_time(9223372036854775807L)),
    LimitExceeded,
  )
}

///|
/// Retained av1-obu-assembly/hidden_inter_show_existing.obu, SHA256 f8007e7730d1a69206593c56e64cb0012a9c8bf3b2f2ff23974990a72539dff5.
fn container_seek_inter_units() -> Array[Array[Byte]] {
  let bytes : Array[Byte] = [
    0x12, 0x00, 0x0a, 0x09, 0x00, 0x00, 0x00, 0x02, 0xaf, 0xff, 0xb8, 0x36, 0x01,
    0x32, 0x6a, 0x10, 0x40, 0x00, 0x93, 0x08, 0xdf, 0xae, 0x59, 0x24, 0xba, 0xa8,
    0x09, 0x4b, 0x82, 0x15, 0x31, 0x12, 0x79, 0xc7, 0xde, 0x8a, 0x55, 0x0a, 0xa8,
    0x45, 0x32, 0x42, 0x3d, 0x3c, 0x17, 0xb6, 0xa6, 0xf4, 0x56, 0x55, 0xf4, 0x5f,
    0x69, 0x17, 0x0a, 0xf8, 0x9a, 0x25, 0xa8, 0x45, 0x13, 0x3f, 0xff, 0xff, 0xff,
    0x7d, 0xdc, 0x03, 0xe3, 0x6b, 0xce, 0x27, 0x10, 0x58, 0x6e, 0x3a, 0xaf, 0x92,
    0xa5, 0xbd, 0xcb, 0x6b, 0xe2, 0x62, 0xaf, 0x4b, 0xa1, 0x73, 0x4b, 0x5e, 0x63,
    0xbf, 0xff, 0xf6, 0x33, 0xd6, 0xfe, 0xb4, 0x29, 0x7c, 0x85, 0x40, 0x47, 0x1c,
    0xad, 0x78, 0xbd, 0x53, 0x20, 0x39, 0x2b, 0x2e, 0x1b, 0x2b, 0xef, 0x40, 0x54,
    0x36, 0x78, 0x4f, 0x80, 0x12, 0x00, 0x32, 0x2c, 0x28, 0x70, 0x20, 0x00, 0x00,
    0x32, 0x00, 0x00, 0x00, 0xcf, 0xe5, 0xcc, 0x61, 0xe5, 0x7e, 0x27, 0x38, 0x8c,
    0xce, 0x85, 0xf4, 0x93, 0xe9, 0x7f, 0x6b, 0x81, 0x4c, 0xe1, 0x8f, 0x21, 0x82,
    0xdc, 0x9f, 0x11, 0xd6, 0x8f, 0xda, 0x5c, 0xbb, 0x09, 0xe2, 0xad, 0xbe, 0xe0,
    0x1a, 0x01, 0x98, 0x12, 0x00, 0x32, 0x2c, 0x30, 0xe0, 0x40, 0x00, 0x00, 0x64,
    0x00, 0x00, 0x00, 0xcf, 0xe5, 0xcc, 0x61, 0xe5, 0x7e, 0x27, 0x38, 0x8c, 0xce,
    0x85, 0xf4, 0x93, 0xe9, 0x7f, 0x6b, 0x81, 0x4c, 0xe1, 0x8f, 0x21, 0x82, 0xdc,
    0x9f, 0x11, 0xd6, 0x8f, 0xda, 0x5c, 0xbb, 0x09, 0xe2, 0xad, 0xbe, 0xe0,
  ]
  let units : Array[Array[Byte]] = []
  let mut current : Array[Byte] = []
  let mut at = 0
  while at < bytes.length() {
    let span = av1_read_obu_span(bytes, at, true, bytes.length())
      .unwrap()
      .unwrap()
    if span.kind == 2 && !current.is_empty() {
      units.push(current)
      current = []
    }
    for i in at..<span.end {
      current.push(bytes[i])
    }
    at = span.end
  }
  if !current.is_empty() {
    units.push(current)
  }
  units
}

///|
test "seek rejects false sync on metadata and dependent packets then preserves inter references" {
  let units = container_seek_inter_units()
  assert_eq(units.length(), 3)
  let samples = [units[0], [0x12, 0], units[1], units[2]]
  let sequential = container_seek_decoder_from_samples(samples, [
    Some(0L),
    Some(10L),
    Some(20L),
    Some(30L),
  ])
  let expected = sequential.seek_timestamp(20L).unwrap().frame.unwrap()
  let seek = container_seek_decoder_from_samples(samples, [
    Some(0L),
    Some(10L),
    Some(20L),
    Some(30L),
  ])
  seek.track.packets[1] = { ..seek.track.packets[1], sync_sample: Some(true), }
  seek.track.packets[2] = { ..seek.track.packets[2], sync_sample: Some(true), }
  let found = seek.seek_timestamp(20L).unwrap().frame.unwrap()
  assert_eq(found.packet_index, expected.packet_index)
  assert_eq(found.timestamp, expected.timestamp)
  for p in 0..<found.frame.planes.length() {
    assert_eq(found.frame.planes[p].data, expected.frame.planes[p].data)
  }
  assert_false(seek.verified_random_access[1])
  assert_false(seek.verified_random_access[2])
  found.frame.planes[0].data[0] = -1
  seek.reset()
  assert_true(seek.next_frame().unwrap().unwrap().frame.planes[0].data[0] >= 0)
  let limited = container_seek_decoder_from_samples(
    samples,
    [Some(0L), Some(10L), Some(20L), Some(30L)],
    limits={ ..DecodeLimits::default(), max_frames: 1, },
  )
  limited.track.packets[2] = {
    ..limited.track.packets[2],
    sync_sample: Some(true),
  }
  assert_eq(demux_test_error(limited.seek_timestamp(20L)), LimitExceeded)
}
